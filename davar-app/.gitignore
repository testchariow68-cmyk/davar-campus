# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files, local credential/backup artifacts — never publish
# (seul le modèle sans secret .env.example est versionné)
.env*
!.env.example
# secrets locaux du runtime Cloudflare (wrangler/vite) — jamais publiés
.dev.vars
.dev.vars.*
*.before-free-staging.bak
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3

# réglages de déploiement locaux (sous-domaine Cloudflare) — jamais publiés
# (aucun secret : seulement l'adresse publique, mais elle est propre à chacun)
.deploy-local.json
.deploy-local.txt

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# vinext / Cloudflare (generated; not source)
/.vinext/
/.cloudflare/
/dist/

# python (tests locaux)
__pycache__/

# base de développement locale (jamais une base hébergée)
/dev-data/
