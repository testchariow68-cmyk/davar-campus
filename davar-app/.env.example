# DAVAR Campus — modèle de configuration. AUCUN SECRET RÉEL ICI.
# Copiez ce fichier en .env.local pour travailler en local ; .env.local n'est
# jamais versionné et ne doit jamais être transmis.

# ---------------------------------------------------------------- environnement
# development | staging | production. Sans valeur, l'application déduit
# production si NODE_ENV=production, sinon développement.
APP_ENV=development

# Origine publique utilisée dans les liens envoyés par e-mail.
# Obligatoire hors développement (https). En développement, l'origine de la
# requête est utilisée à défaut.
# APP_PUBLIC_ORIGIN=https://campus.davaracademie.ci

# ------------------------------------------------------------------- base Turso
# Développement : base locale fichier (aucun secret requis).
TURSO_DATABASE_URL=file:./dev-data/davar-dev.db
# Staging/production : URL libsql:// ou https:// + jeton + hôte attendu.
# TURSO_DATABASE_URL=libsql://davar-campus-staging-xxxx.turso.io
# TURSO_AUTH_TOKEN=…
# TURSO_EXPECTED_HOST=davar-campus-staging-xxxx.turso.io

# ------------------------------------------------------- mots de passe (PBKDF2)
# 600 000 itérations par défaut (recommandation OWASP PBKDF2-HMAC-SHA256).
# Ne descendre en dessous de 210 000 qu'en développement.
# AUTH_PBKDF2_ITERATIONS=600000

# Où le hachage est calculé :
#   local  = dans le processus courant (développement, hôte Node). Refusé en
#            staging/production sans AUTH_ALLOW_LOCAL_KDF=true.
#   remote = délégué au service auth-kdf-service/ (obligatoire pour Cloudflare
#            Workers Free, dont le plafond est de 10 ms de CPU par requête).
# Sans valeur : « local » en développement, « remote » sinon.
AUTH_KDF_MODE=local
# AUTH_KDF_URL=https://kdf.votre-domaine.ci/v1/kdf
# AUTH_KDF_TOKEN=            # 32 caractères minimum, secret partagé
# AUTH_KDF_ALLOWED_ORIGINS=https://kdf.votre-domaine.ci   # liste d'origines acceptées

# ------------------------------------------------------- quotas gratuits à protéger
# Budgets par défaut = offres gratuites retenues (voir ARCHITECTURE-GRATUITE.md).
# Ne les réduire que pour tester ; ne les augmenter qu'en connaissance de cause.
# QUOTA_DAILY_WORKER_REQUESTS=100000
# QUOTA_MONTHLY_ROWS_WRITTEN=10000000
# QUOTA_MONTHLY_ROWS_READ=500000000
# QUOTA_DAILY_EMAILS=300
# QUOTA_DAILY_KDF=3000
# Nombre d'opérations comptées avant écriture en base (1 écriture pour N).
# QUOTA_FLUSH_EVERY=20

# ------------------------------------------- envoi des e-mails (fermé par défaut)
# none (défaut) = aucune inscription réelle hors développement : l'application
# refuse plutôt que de créer un compte impossible à confirmer.
# brevo = API transactionnelle gratuite (300 e-mails/jour, sans carte bancaire).
# apps_script = script Google Apps Script existant (quota Google plus serré).
MAILER_KIND=none
# BREVO_API_KEY=            # clé API Brevo (en-tête api-key, jamais dans le corps)
# MAIL_FROM_EMAIL=campus@votre-domaine.ci   # adresse d'expédition vérifiée chez Brevo
# MAIL_FROM_NAME=Davar Académie Campus
# MAIL_APPS_SCRIPT_URL=https://script.google.com/macros/s/…/exec
# MAIL_APPS_SCRIPT_TOKEN=

# ------------------------------------------------------------- diagnostic privé
# Ouvre GET /api/internal/turso-readiness et GET /api/internal/quota
# (32 caractères minimum). Ce second point de diagnostic affiche la consommation
# face aux quotas gratuits : c'est l'instrument de la règle « on protège les quotas ».
# APP_DIAGNOSTIC_TOKEN=…

# ------------------------------------------------------------ Pulse Chariow (fermé)
# Ne passer à true QU'APRÈS les tests et la revue décrits dans MISE-EN-SERVICE.md.
# CHARIOW_ENABLE_PULSE=false
# CHARIOW_PULSE_SECRET=whsec_…
# CHARIOW_PULSE_ID=pulse_…
# CHARIOW_API_KEY=sk_…
# CHARIOW_STORE_ID=str_…
