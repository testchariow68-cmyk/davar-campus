# DAVAR Campus — modèle de configuration. AUCUN SECRET RÉEL ICI.
# Copiez ce fichier en .env.local pour travailler en local ; .env.local n'est
# jamais versionné et ne doit jamais être transmis.

# ---------------------------------------------------------------- environnement
# development | staging | production. Sans valeur, l'application déduit
# production si NODE_ENV=production, sinon développement.
APP_ENV=development

# Origine publique utilisée dans les liens envoyés par e-mail.
# Obligatoire hors développement (https). En développement, l'origine de la
# requête est utilisée à défaut.
# APP_PUBLIC_ORIGIN=https://campus.davaracademie.ci

# ------------------------------------------------------------------- base Turso
# Développement : base locale fichier (aucun secret requis).
TURSO_DATABASE_URL=file:./dev-data/davar-dev.db
# Staging/production : URL libsql:// ou https:// + jeton + hôte attendu.
# TURSO_DATABASE_URL=libsql://davar-campus-staging-xxxx.turso.io
# TURSO_AUTH_TOKEN=…
# TURSO_EXPECTED_HOST=davar-campus-staging-xxxx.turso.io

# ------------------------------------------------------- mots de passe (PBKDF2)
# 600 000 itérations par défaut (recommandation OWASP PBKDF2-HMAC-SHA256).
# Ne descendre en dessous de 210 000 qu'en développement.
# AUTH_PBKDF2_ITERATIONS=600000

# ---------------------------------------------------- envoi des e-mails (fermé)
# none (défaut) = aucune inscription réelle hors développement.
# apps_script = envoi via un script Google Apps Script qui VÉRIFIE le secret.
# MAILER_KIND=apps_script
# MAIL_APPS_SCRIPT_URL=https://script.google.com/macros/s/…/exec
# MAIL_APPS_SCRIPT_TOKEN=…

# ------------------------------------------------------------- diagnostic privé
# Ouvre GET /api/internal/turso-readiness (32 caractères minimum).
# APP_DIAGNOSTIC_TOKEN=…

# ------------------------------------------------------------ Pulse Chariow (fermé)
# Ne passer à true QU'APRÈS les tests et la revue décrits dans MISE-EN-SERVICE.md.
# CHARIOW_ENABLE_PULSE=false
# CHARIOW_PULSE_SECRET=whsec_…
# CHARIOW_PULSE_ID=pulse_…
# CHARIOW_API_KEY=sk_…
# CHARIOW_STORE_ID=str_…
