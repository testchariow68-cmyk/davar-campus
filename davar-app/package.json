{
  "name": "davar-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev -H 0.0.0.0 -p 3000",
    "build": "next build",
    "start": "next start",
    "dev:vinext": "vite dev --host 0.0.0.0 --port 3001",
    "build:vinext": "vite build",
    "start:vinext": "vite preview --host 0.0.0.0 --port 3001",
    "typecheck": "next typegen && tsc --noEmit",
    "db:dev": "node --experimental-strip-types scripts/dev-db.mjs --migrate",
    "db:seed": "node --experimental-strip-types scripts/dev-db.mjs --migrate --seed",
    "db:reset": "node --experimental-strip-types scripts/dev-db.mjs --reset --migrate --seed",
    "test": "node --experimental-strip-types --test tests/chariow-signature.test.mjs tests/chariow-validate.test.mjs tests/auth-core.test.mjs tests/chariow-ledger.test.mjs",
    "test:sql": "python3 -m unittest -q tests/test_turso_core.py tests/test_auth_schema.py tests/test_migrations_manifest.py"
  },
  "dependencies": {
    "@libsql/client": "^0.15.15",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.109.0",
    "next": "16.3.6",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "2.0.0-beta.sha-52b0dc0e9",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vinext/cloudflare": "1.0.1",
    "@vitejs/plugin-react": "6.1.1",
    "@vitejs/plugin-rsc": "0.5.35",
    "cf": "1.0.0-beta.12",
    "react-server-dom-webpack": "19.2.8",
    "typescript": "^5",
    "vinext": "1.0.1",
    "vite": "8.3.0"
  }
}
